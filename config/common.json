// Common ChordPro configuration for the songbook (shared by A4 and A5).
// Relaxed JSON: comments and trailing commas are allowed.
{
    // Song lyrics are Czech/Slovak/Russian: use TTF fonts with full Unicode coverage.
    "pdf" : {
        // don't insert blank pages to make songs start on odd (right-hand) pages
        "even-odd-pages" : 0,
        "pagealign-songs" : 0,

        // Keep 2-page songs on facing pages (no page turn mid-song); "compact"
        // fills the alignment gaps with 1-page songs instead of blank pages.
        "sort-pages" : "2page,compact",

        "fontdir" : [ "C:/Windows/Fonts" ],
        // Serif lyrics, bold sans chords/titles for clear visual separation.
        "fonts" : {
            "title"    : { "file" : "arialbd.ttf" },
            "subtitle" : { "file" : "ariali.ttf" },
            "text"     : { "file" : "times.ttf" },
            "chord"    : { "file" : "arialbd.ttf", "color" : "#1a4d8f" },
            "comment"  : { "file" : "ariali.ttf" },
            "label"    : { "file" : "arialbd.ttf", "color" : "#666666" },
            "toc"      : { "file" : "times.ttf" },
            "tab"      : { "file" : "consola.ttf" },
        },

        // Extra breathing room between lyric lines with chords above them.
        "spacing" : {
            "lyrics" : 1.25,
            "chords" : 1.15,
            "empty"  : 0.8,
            "toc"    : 1.35,
        },

        // Centered page number in the footer
        "formats" : {
            "default" : {
                "footer" : [ "", "%{page}", "" ],
            },
        },

        // Verse numbers in the left margin (like the songs package did)
        "labels" : {
            "width" : "auto",
            "align" : "left",
        },

        // Chorus marked with a vertical bar, like the songs package
        "chorus" : {
            "indent" : 0,
            "bar" : { "offset" : 8, "width" : 1, "color" : "foreground" },
            "recall" : { "quote" : false, "type" : "" },
        },

        // Chord diagrams for chords defined inside a song ({define: ...})
        "diagrams" : {
            "show" : "bottom",
        },
    },

    // Two-column songs by default (songs package default); {columns: 1} overrides per song.
    "settings" : {
        "columns" : 2,
    },

    // Alphabetical index of songs
    "contents" : [
        {
            "fields" : [ "sorttitle" ],
            "label"  : "Abecední seznam písní",
            "line"   : "%{title}",
            "pageno" : "%{page}",
            "fold"   : false,
            "omit"   : false,
        },
    ],
}
